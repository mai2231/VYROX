{
  "name": "vyrox",
  "version": "1.0.0",
  "private": true,
  "description": "VYROX — premium general e-commerce storefront and admin console. Phase 1 frontend.",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:html",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/css/vyrox.css --minify",
    "build:html": "node ./tools/build-html.mjs",
    "dev": "tailwindcss -i ./src/input.css -o ./dist/css/vyrox.css --watch",
    "start": "npm run build && node ./tools/serve.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "lucide-static": "^1.73.0",
    "tailwindcss": "3.4.17"
  }
}
